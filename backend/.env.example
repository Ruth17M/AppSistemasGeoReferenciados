# Puerto donde escucha la API (Render lo asigna automáticamente)
PORT=3000

# Cadena de conexión de MongoDB Atlas (NO subir la real al repositorio)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=acopiomap

# Secreto para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# Orígenes permitidos para CORS, separados por coma (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Opcional: servidores DNS para resolver mongodb+srv en redes que bloquean SRV
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Usuario de prueba que crea el script "npm run seed"
SEED_USER_EMAIL=demo@acopiomap.mx
SEED_USER_PASSWORD=Demo12345
